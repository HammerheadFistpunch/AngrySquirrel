# Public TinaCloud project identifier. Safe to expose to the browser.
TINA_PUBLIC_CLIENT_ID=bce22d76-7099-40c4-9574-e69b5555a914

# Read-only content token from the TinaCloud project dashboard.
# Keep the real value in .env locally and in Cloudflare Pages environment variables.
TINA_TOKEN=replace-with-your-read-only-token

# Local feature testing. Pages uses CF_PAGES_BRANCH automatically.
# Production edits target main; never pin preview builds to main.
GITHUB_BRANCH=development

# Pages Function runtime configuration for the deliberate Publish Site workflow.
# Store CLOUDFLARE_DEPLOY_HOOK_URL as an encrypted Cloudflare secret. Never put
# the real hook URL in this file, Tina public variables, or repository content.
CLOUDFLARE_ACCESS_DOMAIN=https://replace-with-team-name.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-access-application-audience
PUBLISH_ALLOWED_EMAIL=replace-with-access-identity-email
CLOUDFLARE_DEPLOY_HOOK_URL=replace-with-encrypted-pages-secret
PUBLISH_GITHUB_REPOSITORY=HammerheadFistpunch/GTP_Port
PUBLISH_GITHUB_BRANCH=main
