# Static assets only; Pages Functions retain their own response headers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com https://challenges.cloudflare.com; media-src 'self' https: blob:; form-action 'self'

# Start with one day, on the production hostname only. No includeSubDomains/preload.
https://angrysquirrel.org/*
  Strict-Transport-Security: max-age=86400

# Tina's editor has a separate resource policy; preserve editor integrations.
/admin/*
  ! Content-Security-Policy-Report-Only
  ! Permissions-Policy

/deployment.json
  Cache-Control: no-store

/admin/api/publish
  Cache-Control: no-store

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
