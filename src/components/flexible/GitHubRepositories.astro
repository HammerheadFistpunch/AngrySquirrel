---
import type { FlexiblePageBlock } from "../../lib/page-blocks";

type Props = Extract<FlexiblePageBlock, { _template: "githubRepositories" }>;
const { heading, repositories } = Astro.props;
---

{heading && <h2>{heading}</h2>}
<ul class="github-repositories">
  {repositories.map(({ repository, title, summary }) => (
    <li class="github-repository" data-github-repository={repository}>
      <h3><a href={`https://github.com/${repository}`}>{title || repository.split("/")[1]}</a></h3>
      <p>{summary}</p>
      <ul class="github-repository__metadata" data-repository-metadata hidden></ul>
    </li>
  ))}
</ul>

<script is:inline type="module" src="/scripts/github-repositories.js"></script>

<style>
  .github-repositories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .github-repository {
    padding: var(--space-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow-wrap: anywhere;
  }

  .github-repository h3,
  .github-repository p {
    margin: 0;
  }

  .github-repository p {
    margin-top: var(--space-xs);
  }

  .github-repository__metadata:not([hidden]) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    margin: var(--space-sm) 0 0;
    padding: 0;
    list-style: none;
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: 0.85rem;
  }
</style>
