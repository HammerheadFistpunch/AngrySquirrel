---
import type { CollectionEntry } from "astro:content";
import { marked } from "marked";
import ImmichGallery from "../portfolio/ImmichGallery.astro";
import VideoEmbed from "../portfolio/VideoEmbed.astro";
import GitHubRepositories from "./GitHubRepositories.astro";
import Button from "../ui/Button.astro";
import { sanitizeHref, sanitizeImageSrc } from "@tinacms/astro/sanitize";
import type { FlexiblePageBlock } from "../../lib/page-blocks";
import { normalizeFlexiblePagePath } from "../../lib/flexible-pages";
import { getSupportedImageSource } from "../../lib/image-sources";

interface Props {
  blocks?: FlexiblePageBlock[];
  flexiblePages?: CollectionEntry<"flexiblePages">[];
}

const { blocks = [], flexiblePages = [] } = Astro.props;
const publishedPages = new Map(
  flexiblePages
    .filter((page) => !page.data.draft)
    .map((page) => [normalizeFlexiblePagePath(page.data.path), page]),
);

const renderMarkdown = (markdown: string) =>
  marked.parse(markdown, { async: false, gfm: true }) as string;

const hasText = (value?: string) => Boolean(value?.trim());
const safeHref = (value?: string) => sanitizeHref(value, "");
const safeImage = (value?: string) => sanitizeImageSrc(getSupportedImageSource(value));
const safeExternalUrl = (value?: string) => {
  const sanitized = safeHref(value, "");
  return /^https?:\/\//i.test(sanitized) ? sanitized : "";
};
const resolveBentoHref = (internalPath?: string, href?: string) => {
  if (hasText(internalPath)) {
    const normalized = normalizeFlexiblePagePath(internalPath || "");
    if (publishedPages.has(normalized)) return `/${normalized}/`;
  }

  return safeHref(href);
};

const renderableBlocks = blocks.filter((block) => {
  switch (block._template) {
    case "richText":
      return hasText(block.markdown);
    case "image":
      return Boolean(safeImage(block.src));
    case "youtube":
      return hasText(block.url) && hasText(block.title);
    case "immichGallery":
      return Boolean(safeExternalUrl(block.shareUrl));
    case "githubRepositories":
      return block.repositories.length > 0;
    case "childPages":
      return hasText(block.heading) || hasText(block.introduction) ||
        block.paths.some((path) => publishedPages.has(normalizeFlexiblePagePath(path)));
    case "bentoGrid":
      return hasText(block.heading) || hasText(block.introduction) ||
        block.tiles.some((tile) => hasText(tile.title));
    case "callToAction":
      return hasText(block.label) && Boolean(safeHref(block.href));
  }
});
---

{renderableBlocks.length > 0 && (
  <div class="page-blocks" data-page-blocks>
    {renderableBlocks.map((block) => (
      <section class={`page-block page-block--${block._template}`}>
        {block._template === "richText" && hasText(block.markdown) && (
          <>
            {block.heading && <h2>{block.heading}</h2>}
            <div class="page-block__rich-text" set:html={renderMarkdown(block.markdown)} />
          </>
        )}

        {block._template === "image" && safeImage(block.src) && (
          <>
            {block.heading && <h2>{block.heading}</h2>}
            <figure data-inline-lightbox-target>
              <img
                src={safeImage(block.src)}
                alt={block.alt || ""}
                data-lightbox-caption={block.caption}
                loading="lazy"
                decoding="async"
              />
              {block.caption && <figcaption>{block.caption}</figcaption>}
            </figure>
          </>
        )}

        {block._template === "youtube" && hasText(block.url) && hasText(block.title) && (
          <>
            {block.heading && <h2>{block.heading}</h2>}
            <VideoEmbed src={block.url} title={block.title} provider="youtube" caption={block.caption} />
          </>
        )}

        {block._template === "immichGallery" && safeExternalUrl(block.shareUrl) && (
          <ImmichGallery
            shareUrl={safeExternalUrl(block.shareUrl)}
            title={block.heading || "Photo gallery"}
            imageAltPrefix={block.imageAltPrefix}
          />
        )}

        {block._template === "githubRepositories" && <GitHubRepositories {...block} />}

        {block._template === "childPages" && (
          <>
            {block.heading && <h2>{block.heading}</h2>}
            {block.introduction && <p>{block.introduction}</p>}
            <div class="page-block__tiles">
              {block.paths.flatMap((path) => {
                const normalizedPath = normalizeFlexiblePagePath(path);
                const page = publishedPages.get(normalizedPath);

                if (!page) return [];

                return [
                  <a class="page-block__tile" href={`/${normalizedPath}/`}>
                    <h3>{page.data.navigationLabel || page.data.title}</h3>
                    <p>{page.data.description}</p>
                  </a>,
                ];
              })}
            </div>
          </>
        )}

        {block._template === "bentoGrid" && (
          <>
            {(block.heading || block.introduction) && (
              <div class="page-block__bento-heading">
                {block.heading && <h2>{block.heading}</h2>}
                {block.introduction && <p>{block.introduction}</p>}
              </div>
            )}
            <div class="page-block__bento-grid">
              {block.tiles.filter((tile) => hasText(tile.title)).map((tile) => {
                const href = resolveBentoHref(tile.internalPath, tile.href);
                const image = safeImage(tile.image);
                const content = (
                  <>
                    {image && (
                      <div class="page-block__bento-image">
                        <img src={image} alt={tile.imageAlt || ""} loading="lazy" decoding="async" />
                      </div>
                    )}
                    <div class="page-block__bento-copy">
                      {tile.eyebrow && <p class="page-block__bento-eyebrow">{tile.eyebrow}</p>}
                      <h3>{tile.title}</h3>
                      {tile.description && <p>{tile.description}</p>}
                      {href && (
                        <span class="page-block__bento-link">
                          {tile.linkLabel || "View"} <span aria-hidden="true">→</span>
                        </span>
                      )}
                    </div>
                  </>
                );

                return href ? (
                  <a class={`page-block__bento-tile page-block__bento-tile--${tile.size}`} href={href}>
                    {content}
                  </a>
                ) : (
                  <article class={`page-block__bento-tile page-block__bento-tile--${tile.size}`}>
                    {content}
                  </article>
                );
              })}
            </div>
          </>
        )}

        {block._template === "callToAction" && hasText(block.label) && safeHref(block.href) && (
          <div class="page-block__cta">
            <div>
              {block.heading && <h2>{block.heading}</h2>}
              {block.text && <p>{block.text}</p>}
            </div>
            <Button href={safeHref(block.href)} variant={block.style}>{block.label}</Button>
          </div>
        )}
      </section>
    ))}
  </div>
)}

<style>
  .page-blocks {
    display: grid;
    gap: var(--space-lg);
  }

  .page-block {
    padding: 0;
  }

  .page-block h2 {
    margin-bottom: var(--space-sm);
  }

  .page-block figure {
    margin: 0;
  }

  .page-block figure img {
    display: block;
    width: 100%;
    max-height: 42rem;
    height: auto;
    object-fit: contain;
    background: var(--bg-surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    cursor: zoom-in;
  }

  .page-block figcaption {
    margin-top: 0.75rem;
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }

  .page-block__tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  .page-block__tile {
    display: block;
    padding: var(--space-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
  }

  .page-block__tile h3,
  .page-block__tile p,
  .page-block__cta p {
    margin: 0;
  }

  .page-block__tile p {
    margin-top: var(--space-xs);
    color: var(--text-secondary);
  }

  .page-block__bento-heading {
    margin-bottom: var(--space-md);
  }

  .page-block__bento-heading h2,
  .page-block__bento-heading p {
    margin-top: 0;
  }

  .page-block__bento-heading p {
    max-width: 70ch;
    margin-bottom: 0;
    color: var(--text-secondary);
  }

  .page-block__bento-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(10rem, auto);
    grid-auto-flow: dense;
    gap: var(--space-sm);
  }

  .page-block__bento-tile {
    position: relative;
    display: flex;
    min-width: 0;
    overflow: hidden;
    flex-direction: column;
    grid-column: span 2;
    min-height: 15rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    text-decoration: none;
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  a.page-block__bento-tile:hover,
  a.page-block__bento-tile:focus-visible {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--shadow-soft);
  }

  .page-block__bento-tile--wide {
    grid-column: span 4;
  }

  .page-block__bento-tile--large {
    grid-column: span 4;
    grid-row: span 2;
    min-height: 24rem;
  }

  .page-block__bento-image {
    min-height: 8rem;
    flex: 1 1 10rem;
    overflow: hidden;
    background: var(--bg-elevated);
  }

  .page-block__bento-image img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 100%;
    object-fit: cover;
  }

  .page-block__bento-copy {
    padding: var(--space-md);
  }

  .page-block__bento-copy h3,
  .page-block__bento-copy p {
    margin: 0;
  }

  .page-block__bento-copy h3 {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.08;
  }

  .page-block__bento-copy h3 + p {
    margin-top: var(--space-xs);
    color: var(--text-secondary);
  }

  .page-block__bento-eyebrow {
    margin-bottom: 0.5rem !important;
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-block__bento-link {
    display: inline-block;
    margin-top: var(--space-sm);
    font-family: var(--font-ui);
    font-weight: 700;
  }

  .page-block__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
  }

  .page-block__cta h2 {
    margin-bottom: var(--space-xs);
  }

  @media (max-width: 900px) {
    .page-block__bento-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
    }

    .page-block__bento-tile,
    .page-block__bento-tile--wide,
    .page-block__bento-tile--large {
      grid-row: auto;
    }

    .page-block__bento-tile {
      grid-column: span 1;
    }

    .page-block__bento-tile--wide,
    .page-block__bento-tile--large {
      grid-column: span 2;
    }
  }

  @media (max-width: 760px) {
    .page-blocks {
      gap: var(--space-md);
    }

    .page-block figure img {
      max-height: 70vh;
    }
  }

  @media (max-width: 640px) {
    .page-block__tiles,
    .page-block__bento-grid {
      grid-template-columns: 1fr;
    }

    .page-block__bento-tile,
    .page-block__bento-tile--wide,
    .page-block__bento-tile--large {
      grid-column: span 1;
      min-height: 0;
    }

    .page-block__cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
