---
import TagLinks from "../content/TagLinks.astro";
import type { ResolvedTag } from "../../lib/tags";

interface Props {
  title: string;
  excerpt: string;
  image?: string;
  date: string;
  category: string;
  href: string;
  variant?: "default" | "editorial";
  tags?: ResolvedTag[];
  pinned?: boolean;
}

const {
  title,
  excerpt,
  image,
  date,
  category,
  href,
  variant = "default",
  tags = [],
  pinned = false,
} = Astro.props;
---

<article class:list={["journal-card", { "journal-card--editorial": variant === "editorial" }]}>

  <a class="image-link" href={href} aria-label={`Read ${title}`}>
    {image ? (
      <img
        src={image}
        alt=""
        loading="lazy"
      />
    ) : (
      <div class="image-placeholder" aria-hidden="true">
        <span>{category}</span>
      </div>
    )}
  </a>

  <div class="content">

    <div class="meta">{pinned && <span>Pinned · </span>}{category}</div>

    <h3>
      <a href={href}>{title}</a>
    </h3>

    <p>
      {excerpt}
    </p>

    <div class="date">{date}</div>

    <TagLinks {tags} label={`${title} tags`} compact />

  </div>

</article>


<style>

.journal-card {

  display:grid;

  grid-template-columns:220px 1fr;

  gap:1.5rem;

  padding-bottom:2rem;

  margin-bottom:2rem;

  border-bottom:1px solid var(--border-color);

  color:inherit;

  text-decoration:none;

}

.image-link {
  align-self: start;
  color: inherit;
  text-decoration: none;
}


.journal-card img {

  width:100%;

  aspect-ratio:16 / 10;

  object-fit:cover;

  border-radius:var(--radius-sm);

}

.image-placeholder {

  display:grid;

  place-items:center;

  min-height:138px;

  aspect-ratio:16 / 10;

  background:var(--bg-elevated);

  border:1px solid var(--border-color);

  border-radius:var(--radius-sm);

  color:var(--accent);

  font-family:var(--font-ui);

  font-size:.8rem;

  font-weight:700;

  letter-spacing:.08em;

  text-transform:uppercase;

}


.content h3 {

  margin:.5rem 0 1rem;

}

.content h3 a {
  color: inherit;
  text-decoration: none;
}


.meta {

  font-family:var(--font-ui);

  font-size:.85rem;

  letter-spacing:.08em;

  text-transform:uppercase;

  color:var(--accent);

}

.date {
  margin-top: 1rem;
  color: var(--text-secondary);
  font-family: var(--font-ui);
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}


.content p {

  margin:0;

}


.journal-card h3 a:hover,
.journal-card h3 a:focus-visible {

  color:var(--accent);

}

.journal-card--editorial {
  grid-template-columns: minmax(220px, 38%) 1fr;
  gap: clamp(1.5rem, 4vw, 2.5rem);
  padding-bottom: 1.25rem;
  margin-bottom: 1.25rem;
}

.journal-card--editorial .content h3 {
  margin: .45rem 0 .65rem;
  font-size: clamp(1.35rem, 2.5vw, 1.75rem);
}

.content :global(.tag-links) {
  margin-top: .75rem;
}


@media(max-width:800px){

  .journal-card {

    grid-template-columns:1fr;

  }

  .journal-card--editorial {
    grid-template-columns: 1fr;
  }

}

</style>

