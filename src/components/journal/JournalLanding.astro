---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../ui/Container.astro";
import CategoryNav from "./CategoryNav.astro";
import FeaturedArticle from "./FeaturedArticle.astro";
import JournalCard from "./JournalCard.astro";
import { journalSectionHref, type ResolvedJournalSection } from "../../lib/journal-sections";
import type { ResolvedTag } from "../../lib/tags";

export interface JournalPostSummary {
  title: string;
  excerpt: string;
  image?: string;
  date: string;
  section: string;
  href: string;
  tags: ResolvedTag[];
  pinned?: boolean;
}

interface Props {
  title: string;
  eyebrow?: string;
  headline: string;
  description: string;
  sectionTitle: string;
  emptyMessage: string;
  posts: JournalPostSummary[];
  sections: ResolvedJournalSection[];
  featuredPost?: JournalPostSummary;
  activeSection?: string;
  canonicalPath?: string;
}

const {
  title,
  eyebrow,
  description,
  sectionTitle,
  emptyMessage,
  posts,
  sections,
  featuredPost,
  activeSection,
  canonicalPath,
} = Astro.props;

const sectionLinks = [
  { label: "Latest", href: "/journal/", active: !activeSection },
  ...sections.map((section) => ({
    label: section.label,
    href: journalSectionHref(section.slug),
    active: activeSection === section.slug,
  })),
];
---

<BaseLayout title={title} description={description} {canonicalPath}>
  <div class="journal-shell">
    <Container>
      <header class="journal-header">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
      </header>

      <CategoryNav categories={sectionLinks} />

      {featuredPost && (
        <section class="featured-story" aria-label="Featured Journal story">
          <FeaturedArticle
            title={featuredPost.title}
            excerpt={featuredPost.excerpt}
            image={featuredPost.image}
            category={`Featured · ${featuredPost.section}`}
            date={featuredPost.date}
            href={featuredPost.href}
            variant="split"
            tags={featuredPost.tags}
          />
        </section>
      )}

      <section class="latest-stories" aria-labelledby="journal-entries">
        <h2 id="journal-entries">{sectionTitle}</h2>
        {posts.length > 0 ? (
          <div class="story-list">
            {posts.map((post) => (
              <JournalCard
                title={post.title}
                excerpt={post.excerpt}
                image={post.image}
                date={post.date}
                category={post.section}
                href={post.href}
                variant="editorial"
                tags={post.tags}
                pinned={post.pinned}
              />
            ))}
          </div>
        ) : (
          <p>{emptyMessage}</p>
        )}
      </section>
    </Container>
  </div>
</BaseLayout>

<style>
  .journal-shell { padding: clamp(2.5rem, 6vw, 5rem) 0 var(--space-xl); }
  .journal-header { max-width: 52rem; margin-bottom: var(--space-md); }
  .eyebrow {
    margin-bottom: var(--space-sm);
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .journal-header h1 { max-width: 24ch; font-size: clamp(2.15rem, 5vw, 3.8rem); }
  .featured-story {
    padding: clamp(2rem, 5vw, 4rem) 0;
    border-bottom: 1px solid var(--border-color);
  }
  .latest-stories { padding-top: var(--space-md); }
  .latest-stories > h2 {
    margin-bottom: var(--space-sm);
    font-family: var(--font-ui);
    font-size: .95rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .story-list { max-width: 68rem; }
  @media (max-width: 800px) { .journal-shell { padding-top: var(--space-md); } }
</style>

