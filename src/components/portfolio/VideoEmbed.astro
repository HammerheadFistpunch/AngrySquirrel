---
import VideoPlayer from "../media/VideoPlayer.astro";
import { sanitizeHref, sanitizeImageSrc } from "@tinacms/astro/sanitize";

interface Props {
  src: string;
  title: string;
  provider?: "native" | "youtube" | "vimeo";
  poster?: string;
  caption?: string;
}

const { src, title, provider, poster, caption } = Astro.props;

function detectProvider(url: string): "native" | "youtube" | "vimeo" {
  if (/youtu\.be|youtube(?:-nocookie)?\.com/i.test(url)) return "youtube";
  if (/vimeo\.com/i.test(url)) return "vimeo";
  return "native";
}

function getEmbedUrl(url: string, videoProvider: "youtube" | "vimeo") {
  try {
    const parsed = new URL(url);
    const host = parsed.hostname.toLowerCase().replace(/^(www\.|m\.)/, "");

    if (videoProvider === "youtube") {
      const youtubeHosts = new Set([
        "youtube.com",
        "youtube-nocookie.com",
        "youtu.be",
      ]);

      if (!youtubeHosts.has(host)) return undefined;

      const pathParts = parsed.pathname.split("/").filter(Boolean);
      const id = host === "youtu.be"
        ? pathParts[0]
        : parsed.searchParams.get("v") ||
          (["embed", "shorts", "live"].includes(pathParts[0]) ? pathParts[1] : undefined);

      return id && /^[A-Za-z0-9_-]{6,20}$/.test(id)
        ? `https://www.youtube-nocookie.com/embed/${id}`
        : undefined;
    }

    if (host !== "vimeo.com" && host !== "player.vimeo.com") return undefined;
    const id = parsed.pathname.split("/").filter(Boolean).find((part) => /^\d+$/.test(part));
    return id ? `https://player.vimeo.com/video/${id}` : undefined;
  } catch {
    return undefined;
  }
}

const resolvedProvider = provider ?? detectProvider(src);
const embedUrl = resolvedProvider === "native"
  ? undefined
  : getEmbedUrl(src, resolvedProvider);
const watchUrl = embedUrl
  ? resolvedProvider === "youtube"
    ? `https://www.youtube.com/watch?v=${new URL(embedUrl).pathname.split("/").pop()}`
    : `https://vimeo.com/${new URL(embedUrl).pathname.split("/").pop()}`
  : undefined;
const nativeUrl = sanitizeImageSrc(src);
const sanitizedFallbackUrl = sanitizeHref(src, "");
const fallbackUrl = /^https?:\/\//i.test(sanitizedFallbackUrl)
  ? sanitizedFallbackUrl
  : "";
---

{resolvedProvider === "native" && nativeUrl ? (
  <VideoPlayer src={nativeUrl} {title} {poster} {caption} />
) : embedUrl ? (
  <figure class="video-embed">
    <div class="frame">
      <iframe
        src={embedUrl}
        {title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
    <figcaption>
      {caption && <p>{caption}</p>}
      <a href={watchUrl} rel="noopener noreferrer">Watch {title} on {resolvedProvider === "youtube" ? "YouTube" : "Vimeo"} →</a>
    </figcaption>
  </figure>
) : (
  <div class="video-fallback" role="note">
    <p><strong>{title}</strong></p>
    <p>
      This video could not be embedded.
      {fallbackUrl && <a href={fallbackUrl}>Open it on the video site →</a>}
    </p>
    {caption && <p class="fallback-caption">{caption}</p>}
  </div>
)}

<style>
  .video-embed {
    margin: 0;
  }

  .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
  }

  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    text-align: center;
  }

  .video-fallback {
    padding: var(--space-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
  }

  .video-fallback p {
    margin: 0;
  }

  .video-fallback p + p {
    margin-top: var(--space-xs);
  }

  .video-fallback a {
    display: inline-block;
    margin-left: 0.35rem;
  }

  .fallback-caption {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
</style>
