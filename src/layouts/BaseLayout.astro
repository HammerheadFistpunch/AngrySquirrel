---
import "../styles/global.css";

import { getEntry } from "astro:content";
import Navigation from "../components/ui/Navigation.astro";
import Footer from "../components/ui/Footer.astro";
import appearance from "../data/appearance.json";
import { createStructuredData, serializeStructuredData } from "../lib/structured-data";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  canonicalPath?: string;
  article?: { published?: Date; modified?: Date; section: string; keywords: string[] };
}

const {
  title,
  description,
  image,
  type = "website",
  canonicalPath,
  article,
} = Astro.props;

const siteEntry = await getEntry("settings", "site");

if (!siteEntry) {
  throw new Error("Missing site settings: src/content/settings/site.md");
}

const site = siteEntry.data;
const documentTitle = title ? `${title} | ${site.siteName}` : site.siteName;
const documentDescription = description ?? site.siteDescription;
const canonicalUrl = new URL(
  canonicalPath ?? Astro.url.pathname,
  Astro.site ?? Astro.url.origin,
);

const socialImage = image
  ? new URL(image, Astro.site ?? Astro.url.origin).toString()
  : undefined;

const structuredData = createStructuredData({
  name: site.siteName, description: site.siteDescription, author: site.copyrightName,
  url: new URL("/", Astro.site ?? Astro.url.origin).href,
}, {
  url: canonicalUrl.href, title: title ?? site.siteName,
  description: documentDescription, image: socialImage, article,
});

const uiFontStacks: Record<string, string> = {
  Lato: '"Lato", sans-serif',
  Inter: '"Inter", sans-serif',
  "Source Sans 3": '"Source Sans 3", sans-serif',
  "System Sans": 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
};

const editorialFontStacks: Record<string, string> = {
  Newsreader: '"Newsreader", serif',
  Merriweather: '"Merriweather", serif',
  "Source Serif 4": '"Source Serif 4", serif',
  Georgia: 'Georgia, "Times New Roman", serif',
};

const headingScale = Math.max(0.75, Math.min(1.4, Number(appearance.headingScale) || 1));
const scaled = (value: number) => Number((value * headingScale).toFixed(3));

const appearanceStyle = [
  `--font-ui:${uiFontStacks[appearance.uiFont] ?? uiFontStacks.Lato}`,
  `--font-editorial:${editorialFontStacks[appearance.editorialFont] ?? editorialFontStacks.Newsreader}`,
  `--body-font-size:${appearance.bodyFontSize}px`,
  `--article-font-size:${appearance.articleFontSize}px`,
  `--h1-min:${scaled(3)}rem`,
  `--h1-fluid:${scaled(7)}vw`,
  `--h1-max:${scaled(5.5)}rem`,
  `--h2-min:${scaled(2.2)}rem`,
  `--h2-fluid:${scaled(5)}vw`,
  `--h2-max:${scaled(3.4)}rem`,
  `--h3-size:${scaled(2)}rem`,
  `--h4-size:${scaled(1.5)}rem`,
  `--h5-size:${scaled(1.25)}rem`,
  `--h6-size:${scaled(1)}rem`,
  `--line-height:${appearance.lineHeight}`,
  `--content-width:${appearance.contentWidth}px`,
  `--reading-width:${appearance.readingWidth}px`,
  `--bg-primary:${appearance.backgroundColor}`,
  `--bg-surface:${appearance.surfaceColor}`,
  `--bg-elevated:${appearance.elevatedColor}`,
  `--text-primary:${appearance.textColor}`,
  `--text-secondary:${appearance.secondaryTextColor}`,
  `--accent:${appearance.accentColor}`,
  `--radius-sm:${appearance.smallRadius}px`,
  `--radius-md:${appearance.mediumRadius}px`,
  `--space-sm:${appearance.smallSpacing}px`,
  `--space-md:${appearance.mediumSpacing}px`,
  `--space-lg:${appearance.largeSpacing}px`,
  `--space-xl:${appearance.extraLargeSpacing}px`,
].join(";");
---

<!doctype html>

<html lang="en" style={appearanceStyle}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{documentTitle}</title>

    <meta name="description" content={documentDescription} />

    <link rel="canonical" href={canonicalUrl} />
    <script type="application/ld+json" set:html={serializeStructuredData(structuredData)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="TheAngrySquirrel Journal"
      href="/rss.xml"
    />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png"
    />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="theme-color" content={appearance.backgroundColor} />
    <meta name="apple-mobile-web-app-title" content={site.siteName} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={documentDescription} />
    <meta property="og:url" content={canonicalUrl} />

    {
      socialImage && (
        <meta property="og:image" content={socialImage} />
      )
    }

    <!-- Twitter/X -->
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={documentDescription} />

    {
      socialImage && (
        <meta name="twitter:image" content={socialImage} />
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>

    <Navigation />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
