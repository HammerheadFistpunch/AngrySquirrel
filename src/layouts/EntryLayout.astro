---
import JournalComments from "../components/journal/JournalComments.astro";
import BaseLayout from "./BaseLayout.astro";
import ArticleMeta from "../components/journal/ArticleMeta.astro";
import Gallery from "../components/portfolio/Gallery.astro";
import ImmichGallery from "../components/portfolio/ImmichGallery.astro";
import VideoEmbed from "../components/portfolio/VideoEmbed.astro";
import InlineImageLightbox from "../components/portfolio/InlineImageLightbox.astro";
import RelatedEntries from "../components/content/RelatedEntries.astro";
import Container from "../components/ui/Container.astro";
import TagLinks from "../components/content/TagLinks.astro";
import type { ResolvedTag } from "../lib/tags";
import { getSupportedImageSource } from "../lib/image-sources";

interface EntryMedia {
  type: "image" | "video";
  src: string;
  alt?: string;
  caption?: string;
}

interface RelatedEntry {
  title: string;
  description: string;
  image?: string;
  section: string;
  href: string;
}

interface Props {
  articleId: string;
  commentsDisabled?: boolean;
  title: string;
  description: string;
  date?: Date;
  updatedDate?: Date;
  sectionLabel?: string;
  tags?: ResolvedTag[];
  coverImage?: string;
  media?: EntryMedia[];
  immichGallery?: {
    shareUrl: string;
    title?: string;
    imageAltPrefix?: string;
  };
  relatedEntries?: RelatedEntry[];
}

const {
  articleId,
  commentsDisabled = false,
  title,
  description,
  date,
  updatedDate,
  sectionLabel = "Latest",
  tags = [],
  coverImage,
  media = [],
  immichGallery,
  relatedEntries = [],
} = Astro.props;

const safeCoverImage = getSupportedImageSource(coverImage) || undefined;
const galleryImages = media.flatMap((item) => {
  const src = item.type === "image" ? getSupportedImageSource(item.src) : "";
  return src ? [{ src, alt: item.alt || title, caption: item.caption }] : [];
});
const videos = media.filter((item) => item.type === "video");
---

<BaseLayout title={title} description={description} image={safeCoverImage} type="article">
  <article class="entry entry--article" aria-labelledby="entry-title">
    <Container width="reading">
      <nav class="back-links" aria-label="Back to collection">
        <a href="/journal/">← Back to Journal</a>
      </nav>

      <header class="entry-header">
        {date ? (
          <ArticleMeta category={sectionLabel} {date} {updatedDate} />
        ) : (
          <p class="entry-section">{sectionLabel}</p>
        )}
        <h1 id="entry-title">{title}</h1>
        <p class="entry-description">{description}</p>
      </header>

      {safeCoverImage && (
        <figure class="entry-hero">
          <img src={safeCoverImage} alt={title} />
        </figure>
      )}

      <div class="entry-content project-content" data-inline-lightbox-target>
        <slot />
      </div>

      <InlineImageLightbox />
      <Gallery id="entry-gallery" images={galleryImages} />

      {immichGallery && (
        <ImmichGallery
          shareUrl={immichGallery.shareUrl}
          title={immichGallery.title}
          imageAltPrefix={immichGallery.imageAltPrefix}
        />
      )}

      {videos.length > 0 && (
        <section class="entry-videos" aria-labelledby="entry-videos-heading">
          <h2 id="entry-videos-heading">Videos</h2>
          <div class="video-list">
            {videos.map((video, index) => (
              <VideoEmbed
                src={video.src}
                title={video.alt || `${title} video ${index + 1}`}
                caption={video.caption}
              />
            ))}
          </div>
        </section>
      )}

      {!commentsDisabled && <JournalComments article={articleId} />}

      <TagLinks {tags} label="Explore these subjects" />
      <RelatedEntries entries={relatedEntries} />
    </Container>
  </article>
</BaseLayout>

<style>
  .entry { padding: var(--space-md) 0 var(--space-xl); }
  .back-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
    font-family: var(--font-ui);
    font-weight: 700;
  }
  .entry-header {
    margin-bottom: var(--space-md);
    padding: 0 0 var(--space-sm);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--border-color);
  }
  .entry-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    margin: 0 0 var(--space-sm);
    overflow-wrap: anywhere;
  }
  .entry-description,
  .entry-content { font-family: var(--font-editorial); }
  .entry-description {
    max-width: 42rem;
    margin-bottom: 0;
    font-size: 1.2rem;
  }
  .entry-section {
    margin-bottom: .5rem;
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: .85rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .entry-hero { margin: 0 0 var(--space-lg); }
  .entry-hero img {
    width: 100%;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
  }
  .entry-videos { padding-top: var(--space-lg); }
  .entry-videos h2 { margin-bottom: var(--space-md); }
  .video-list { display: grid; gap: var(--space-md); }
</style>
