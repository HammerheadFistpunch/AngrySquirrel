---
import { getCollection, getEntry } from "astro:content";
import { selectFeaturedJournalEntry } from "../../lib/featured-journal";
import JournalLanding, { type JournalPostSummary } from "../../components/journal/JournalLanding.astro";
import { createJournalSectionRegistry, resolveJournalSection } from "../../lib/journal-sections";
import { createTagRegistry, resolveTagReferences } from "../../lib/tags";

const entries = (await getCollection("entries", ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const journalPage = await getEntry("pages", "journal");

if (!journalPage || journalPage.data.pageType !== "archive") {
  throw new Error("Missing Journal page content: src/content/pages/journal.md");
}

const page = journalPage.data;
const dateFormatter = new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" });
const tagRegistry = createTagRegistry(await getCollection("tags"));
const sectionRegistry = createJournalSectionRegistry(await getCollection("journalSections"));

const summarize = (entry: (typeof entries)[number]): JournalPostSummary => ({
  title: entry.data.title,
  excerpt: entry.data.description,
  image: entry.data.coverImage,
  date: entry.data.date ? dateFormatter.format(entry.data.date) : "Date pending",
  section: resolveJournalSection(entry.data.journalSection, sectionRegistry)?.label ?? "Latest",
  href: `/archive/${entry.id}/`,
  tags: resolveTagReferences(entry.data.tags, tagRegistry, entry.data.title),
});

const featuredEntry = selectFeaturedJournalEntry(entries, page.featuredEntry);
const featuredPost = featuredEntry ? summarize(featuredEntry) : undefined;
const posts = entries.filter((entry) => entry.id !== featuredEntry?.id).map(summarize);
---

<JournalLanding
  title={page.title}
  eyebrow={page.eyebrow}
  headline={page.headline}
  description={page.description}
  sectionTitle={page.sectionTitle}
  emptyMessage={page.emptyMessage}
  featuredPost={featuredPost}
  posts={posts}
  sections={sectionRegistry.active}
/>
